    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next"
  },
  "dependencies": {
    "dexie": "4.2.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "6.2.4",
    "gh-pages": "6.3.0",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "type": "module"
}
