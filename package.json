{
  "name": "aurora-chat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:pages": "npm run build && gh-pages -d out -b gh-pages",
