{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora-chat-transfer",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "r2_buckets": [
    {
      "binding": "TRANSFER_BUCKET",
      "bucket_name": "aurora-chat-transfers"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
